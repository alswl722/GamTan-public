# 감탄 환경변수 템플릿 — 이 파일은 커밋 O (실제 키 넣지 말 것)
# 사용법: cp .env.example .env 후 실제 값 채우기

# --- Supabase (PostgreSQL) — Session 모드 풀러 문자열 ---
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# --- Gemini API (전표 분류 도구② + 에이전트 오케스트레이터) ---
# 무료 티어 사용. https://aistudio.google.com/apikey 에서 발급.
GEMINI_API_KEY=

# --- Claude API (현재 미사용 — 오케스트레이터도 Gemini로 통일) ---
ANTHROPIC_API_KEY=

# --- 공공데이터포털: 한국에너지공단 에너지사용·온실가스배출량 통계-마이크로데이터 ---
# scripts/fetch_industry_distributions.py 전용(1회성 배치). data.go.kr 개발계정
# 신청 후 발급되는 "일반 인증키(Encoding)"를 그대로 넣는다.
KEA_GHG_API_KEY=

# --- 기업마당(bizinfo.go.kr) 지원사업정보 API ---
# scripts/fetch_gov_support_programs.py 전용(1일 1회 배치). 공공데이터포털이
# 아니라 bizinfo.go.kr API 안내 페이지(apiDetail.do?id=bizinfoApi)에서 직접
# 발급받는 인증키(crtfcKey)를 넣는다. docs/gov-support-matching-plan.md §3 참고.
BIZINFO_API_KEY=

# --- 공공데이터포털: 중소기업기술정보진흥원_중소벤처24 공고정보 API ---
# scripts/fetch_gov_support_programs.py 2번째 소스(v1 이후 확장, 착수 전).
# data.go.kr에서 활용신청(개발계정은 자동승인) 후 발급되는 서비스키를 넣는다.
# docs/gov-support-matching-plan.md §10 참고.
SMES24_API_KEY=

# --- 앱 설정 ---
APP_ENV=development
