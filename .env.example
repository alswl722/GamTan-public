# 감탄 환경변수 템플릿 — 이 파일은 커밋 O (실제 키 넣지 말 것)
# 사용법: cp .env.example .env 후 실제 값 채우기

# --- Supabase (PostgreSQL) — Session 모드 풀러 문자열 ---
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# --- Gemini API (전표 분류 도구② + 에이전트 오케스트레이터) ---
# 무료 티어 사용. https://aistudio.google.com/apikey 에서 발급.
GEMINI_API_KEY=

# --- Claude API (현재 미사용 — 오케스트레이터도 Gemini로 통일) ---
ANTHROPIC_API_KEY=

# --- 공공데이터포털: 한국에너지공단 에너지사용·온실가스배출량 통계-마이크로데이터 ---
# scripts/fetch_industry_distributions.py 전용(1회성 배치). data.go.kr 개발계정
# 신청 후 발급되는 "일반 인증키(Encoding)"를 그대로 넣는다.
KEA_GHG_API_KEY=

# --- 앱 설정 ---
APP_ENV=development
